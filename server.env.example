# Copy this file to server.env only when you need deployment overrides.
# Never commit server.env. With no configuration the application uses deterministic Mock.
ZHIJIAO_AI_MODE=mock
ZHIJIAO_AI_READ_TIMEOUT=115

# Built-in cloud relay (the relay owns the upstream provider credentials):
# ZHIJIAO_AI_MODE=relay
# ZHIJIAO_RELAY_URL=https://relay.example.edu/v1
# ZHIJIAO_RELAY_TOKEN=replace_with_relay_token

# Direct OpenAI-compatible / Gemini / Ollama endpoint:
# ZHIJIAO_AI_MODE=custom
# ZHIJIAO_CUSTOM_PROVIDER=openai_compatible
# ZHIJIAO_CUSTOM_BASE_URL=https://api.openai.com/v1
# ZHIJIAO_CUSTOM_API_KEY=replace_with_api_key
# ZHIJIAO_CUSTOM_MODEL=gpt-4.1-mini
# For Ollama use provider=ollama, for example http://127.0.0.1:11434/v1;
# the API key may stay empty. Gemini uses its native API base URL and requires a key.

# Legacy direct DashScope mode remains supported:
# ZHIJIAO_AI_MODE=qwen
# DASHSCOPE_API_KEY=replace_with_your_api_key
# ZHIJIAO_AI_PROVIDER=qwen
# ZHIJIAO_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ZHIJIAO_AI_MODEL=qwen-plus

# Optional: store runtime databases and uploads outside the project directory.
# ZHIJIAO_DATA_DIR=D:\path\to\zhijiao_data
# ZHIJIAO_MAX_UPLOAD_MB=500
# ZHIJIAO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ZHIJIAO_TEACHER_AGENT_ENABLED=1
# Required before teachers can import new student accounts. Never commit the real value.
ZHIJIAO_STUDENT_DEFAULT_PASSWORD=

# Teacher shared-course parsing workers. Prefer authenticated HTTPS endpoints.
ZHIJIAO_MINERU_URL=https://mineru.example.edu
ZHIJIAO_MINERU_TOKEN=replace-with-mineru-token
ZHIJIAO_MINERU_VERIFY_TLS=1
ZHIJIAO_MINERU_TIMEOUT=3600
ZHIJIAO_FORMULA_URL=https://pix2text.example.edu
ZHIJIAO_FORMULA_TOKEN=replace-with-pix2text-token
ZHIJIAO_FORMULA_VERIFY_TLS=1
ZHIJIAO_FORMULA_TIMEOUT=600

# Adaptive PDF ingestion. Pages are routed locally and parsed in resumable batches.
ZHIJIAO_INGESTION_BATCH_SIZE=40

# Teacher shared-course knowledge-tree extractor. Only builtin is active.
# Legacy docling_graph values are mapped to builtin without importing Torch.
ZHIJIAO_KNOWLEDGE_EXTRACTOR=builtin
ZHIJIAO_DOCLING_GRAPH_CONTRACT=auto
ZHIJIAO_DOCLING_GRAPH_CHUNK_TOKENS=768
ZHIJIAO_DOCLING_GRAPH_PARALLEL_WORKERS=1
ZHIJIAO_DOCLING_GRAPH_CONTEXT_LIMIT=128000
ZHIJIAO_DOCLING_GRAPH_MAX_OUTPUT_TOKENS=8192
