# 无 API Key 时保持 mock，可完整演示课程问答和练习闭环。
ZHIJIAO_AI_MODE=mock

# 教师批量导入学生前必须设置至少 10 个字符的初始密码。
ZHIJIAO_STUDENT_DEFAULT_PASSWORD=

# 生产环境建议设置随机 JWT 密钥；留空时本地生成到 data/auth_secret。
ZHIJIAO_JWT_SECRET=
ZHIJIAO_COOKIE_SECURE=0
ZHIJIAO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ZHIJIAO_MAX_UPLOAD_MB=500
ZHIJIAO_TEACHER_AGENT_ENABLED=0
ZHIJIAO_SCHOOL_NAME=某高校
ZHIJIAO_SCHOOL_CAMPUSES=校区A,校区B
ZHIJIAO_SCHOOL_MAJORS=信息管理与信息系统

# Legacy labels used only during a private database migration. Keep these in
# the untracked server.env or process environment; do not commit real names.
# ZHIJIAO_LEGACY_SCHOOL_NAMES=legacy-school-label
# ZHIJIAO_LEGACY_CAMPUS_A_NAMES=legacy-campus-a
# ZHIJIAO_LEGACY_CAMPUS_B_NAMES=legacy-campus-b

# OpenAI 兼容接口示例（不要把真实 Key 提交到 Git）
# ZHIJIAO_AI_MODE=custom
# ZHIJIAO_CUSTOM_PROVIDER=openai_compatible
# ZHIJIAO_CUSTOM_BASE_URL=https://example.com/v1
# ZHIJIAO_CUSTOM_API_KEY=
# ZHIJIAO_CUSTOM_MODEL=

# Google Gemini 使用同一 custom 模式，将 provider 改为 gemini。
# 内置云中转示例（上游真实 Key 只保存在中转服务）：
# ZHIJIAO_AI_MODE=relay
# ZHIJIAO_RELAY_URL=https://relay.example.edu/v1
# ZHIJIAO_RELAY_TOKEN=

# Ollama 示例
# ZHIJIAO_AI_MODE=custom
# ZHIJIAO_CUSTOM_PROVIDER=ollama
# 本机启动使用 127.0.0.1；Docker 启动使用 host.docker.internal。
# ZHIJIAO_CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
# ZHIJIAO_CUSTOM_MODEL=qwen2.5:7b
